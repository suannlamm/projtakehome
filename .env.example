# Copy this file to .env.local and fill in each value. See SETUP.md for where to get them.

# [1] Supabase → Project Settings → API (or Connect → App Frameworks)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY

# [2] Supabase → Connect → ORMs / Connection string
# Transaction pooler (port 6543), used by the running app
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Session pooler (port 5432), used only by `npm run db:migrate`
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# [3] TMDB → Settings → API → "API Read Access Token" (the long one, not the short API key)
TMDB_API_TOKEN=YOUR-TMDB-READ-ACCESS-TOKEN

# [4] Google AI Studio → Get API key
GOOGLE_GENERATIVE_AI_API_KEY=YOUR-GEMINI-API-KEY
